{
    "tasks": [
        {
            "label": "copy-freeglut-dll",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "copy",
                "/Y",
                "C:\\msys64\\mingw64\\bin\\libfreeglut.dll",
                "${workspaceFolder}\\bin\\libfreeglut.dll"
            ],
            "presentation": { "reveal": "silent" },
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "shell",
            "command": "g++",
            "args": [
                "-I", "${workspaceFolder}/src",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/audio/Audio.cpp",
                "${workspaceFolder}/src/render/Renderer.cpp",
                "${workspaceFolder}/src/doll/Doll.cpp",
                "${workspaceFolder}/src/doll/DollHead.cpp",
                "${workspaceFolder}/src/doll/DollBody.cpp",
                "${workspaceFolder}/src/doll/DollTree.cpp",
                "${workspaceFolder}/src/guards/Guards.cpp",
                "${workspaceFolder}/src/contestants/Contestants.cpp",
                "${workspaceFolder}/src/environment/Environment.cpp",
                "${workspaceFolder}/src/environment/EnvironmentHouses.cpp",
                "${workspaceFolder}/src/environment/EnvironmentClock.cpp",
                "${workspaceFolder}/src/ui/UI.cpp",
                "${workspaceFolder}/src/camera/Camera.cpp",
                "-o",
                "${workspaceFolder}/bin/game.exe",
                "-lfreeglut",
                "-lopengl32",
                "-lglu32",
                "-lwinmm",
                "-lgdi32"
            ],
            "dependsOn": ["copy-freeglut-dll"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build-modern",
            "type": "shell",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "-O2",
                "-DMODERN_OPENGL",
                "-I", "${workspaceFolder}/src/compat",
                "-I", "${workspaceFolder}/src",
                "-I", "${workspaceFolder}/src/vendor/glad/include",
                "-I", "${workspaceFolder}/src/vendor/imgui",
                "-I", "${workspaceFolder}/src/vendor/imgui/backends",
                "${workspaceFolder}/src/main_modern.cpp",
                "${workspaceFolder}/src/engine/Shader.cpp",
                "${workspaceFolder}/src/engine/Camera.cpp",
                "${workspaceFolder}/src/engine/VAO.cpp",
                "${workspaceFolder}/src/engine/VBO.cpp",
                "${workspaceFolder}/src/engine/EBO.cpp",
                "${workspaceFolder}/src/engine/Mesh.cpp",
                "${workspaceFolder}/src/engine/Primitives.cpp",
                "${workspaceFolder}/src/engine/GLCompat.cpp",
                "${workspaceFolder}/src/audio/Audio.cpp",
                "${workspaceFolder}/src/render/Renderer.cpp",
                "${workspaceFolder}/src/doll/Doll.cpp",
                "${workspaceFolder}/src/doll/DollHead.cpp",
                "${workspaceFolder}/src/doll/DollBody.cpp",
                "${workspaceFolder}/src/doll/DollTree.cpp",
                "${workspaceFolder}/src/guards/Guards.cpp",
                "${workspaceFolder}/src/contestants/Contestants.cpp",
                "${workspaceFolder}/src/environment/Environment.cpp",
                "${workspaceFolder}/src/environment/EnvironmentHouses.cpp",
                "${workspaceFolder}/src/environment/EnvironmentClock.cpp",
                "${workspaceFolder}/src/camera/Camera.cpp",
                "${workspaceFolder}/src/vendor/glad/src/gl.c",
                "${workspaceFolder}/src/vendor/imgui/imgui.cpp",
                "${workspaceFolder}/src/vendor/imgui/imgui_draw.cpp",
                "${workspaceFolder}/src/vendor/imgui/imgui_tables.cpp",
                "${workspaceFolder}/src/vendor/imgui/imgui_widgets.cpp",
                "${workspaceFolder}/src/vendor/imgui/backends/imgui_impl_glfw.cpp",
                "${workspaceFolder}/src/vendor/imgui/backends/imgui_impl_opengl3.cpp",
                "-o",
                "${workspaceFolder}/bin/game_modern.exe",
                "-lglfw3",
                "-lopengl32",
                "-lwinmm",
                "-lgdi32"
            ],
            "group": {
                "kind": "build"
            },
            "problemMatcher": ["$gcc"]
        }
    ],
    "version": "2.0.0"
}
